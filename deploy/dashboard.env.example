# Copy to /etc/container-proxy/dashboard.env with mode 0600.
# Serve through an HTTPS reverse proxy and set its exact external origin.
DASHBOARD_PUBLIC_ORIGIN=https://container-proxy.went.io
DASHBOARD_ADMIN_TOKEN_FILE=/etc/container-proxy/admin-token

# Optional OIDC in addition to the administrator token.
# Register the exact callback URL below with your identity provider.
# DASHBOARD_OIDC_ISSUER=https://identity.example.test/application/o/container-proxy/
# DASHBOARD_OIDC_CLIENT_ID=container-proxy
# DASHBOARD_OIDC_CLIENT_SECRET_FILE=/etc/container-proxy/oidc-client-secret
# DASHBOARD_OIDC_REDIRECT_URL=https://container-proxy.went.io/api/v1/auth/callback
# Use subjects, verified emails, or both. An allowlist is mandatory for OIDC.
# DASHBOARD_OIDC_SUBJECTS=your-immutable-subject
# DASHBOARD_OIDC_EMAILS=admin@example.test
